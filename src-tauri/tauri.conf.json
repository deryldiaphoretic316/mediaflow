{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaFlow",
  "version": "0.1.0",
  "identifier": "com.vkgeorgia.mediaflow",
  "build": {
    "beforeBuildCommand": "",
    "frontendDist": "../static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MediaFlow",
        "width": 1180,
        "height": 820,
        "resizable": true,
        "url": "http://127.0.0.1:8765"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../app.py": "app.py",
      "../requirements.txt": "requirements.txt",
      "../static/": "static/"
    }
  }
}
